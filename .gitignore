*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/
ENV/

# Python 打包文件
build/
dist/
*.egg-info/

# 测试和类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter Notebook 临时文件
.ipynb_checkpoints/


